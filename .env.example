SESSION_SECRET=replace-with-at-least-32-random-characters
USER_USERNAME=user
USER_PASSWORD_HASH=replace-with-bcrypt-hash
METRICS_TOKEN=replace-with-a-long-random-token
MAX_REQUEST_BYTES=100000
MAX_DIAGNOSTIC_SUBSCRIBERS=10
REQUEST_TIMEOUT_MS=30000
DATA_DIR=./data
PORT=8080
HTTPS_PORT=3443
# Set this to the externally reachable origin in deployment.
PUBLIC_ORIGIN=https://localhost:3443
NODE_ENV=development
# Production deployments should provide Redis for shared rate limits and sessions.
REDIS_URL=redis://localhost:6379
